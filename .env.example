# OpenAI writes the storyboard, shoots the stills, voices and judges every scene.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional fallback. Without either key the agent still produces a
# source-faithful video from the manual drawings and a local voice.
GEMINI_API_KEY=

# One vision call reads every page and writes the storyboard.
OPENAI_STORYBOARD_MODEL=gpt-5.5
OPENAI_STORYBOARD_EFFORT=low
# Photo of each step, edited from the manual drawing. Tried in order.
OPENAI_IMAGE_MODEL=gpt-image-2.6-flare,gpt-image-2.5-flare,gpt-image-1.5
OPENAI_IMAGE_QUALITY=medium
OPENAI_JUDGE_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar

# Scenes shot at once, and pages read per manual.
SCENE_CONCURRENCY=12
MAX_PAGES=32

# kenburns (eased camera move per scene) or still (one held picture per
# scene, encoded once). Unset picks still below 4 CPUs.
VIDEO_MOTION=
VIDEO_FPS=25
VIDEO_CRF=21
VIDEO_STILL_CRF=16

# Saved films. Point at a persistent disk in production.
FILM_LIBRARY_DIR=

# Set to 1 to reshoot a sample instead of using content/sample-films/.
SAMPLE_FILM_REGEN=0

# Set to 1 to animate scenes with Veo (Gemini provider only, slower, billed).
USE_VEO=0

# Required if you expose the app beyond this machine.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
