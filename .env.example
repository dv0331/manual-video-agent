# Preferred. US-resident OpenAI endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://us.api.openai.com/v1

# Optional fallback. Without either key the agent still produces a
# source-faithful Ken Burns video from extracted manual figures.
GEMINI_API_KEY=

# Set to 1 to animate scenes with Veo (slower, billed). Default is Ken Burns.
USE_VEO=0

# Required if you expose the app beyond this machine.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
