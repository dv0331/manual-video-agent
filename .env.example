# Preferred. US-resident OpenAI endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://us.api.openai.com/v1

# Optional fallback. Without either key the agent still produces a
# source-faithful Ken Burns video from extracted manual figures.
GEMINI_API_KEY=

# Sora-2 human-assembly clips when OPENAI_API_KEY is set. Set to 0 to skip.
# The film does not wait on Sora unless SORA_WAIT=1 (that path is minutes).
USE_SORA=1
SORA_WAIT=0
OPENAI_VIDEO_MODEL=sora-2
OPENAI_VIDEO_SECONDS=8
OPENAI_IMAGE_QUALITY=low
SCENE_CONCURRENCY=8

# Spoken step narration. Falls back to local espeak-ng if TTS is unavailable.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Set to 1 to reshoot a sample instead of using content/sample-films/.
SAMPLE_FILM_REGEN=0

# Set to 1 to animate scenes with Veo (slower, billed). Default is Ken Burns.
USE_VEO=0

# Required if you expose the app beyond this machine.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
